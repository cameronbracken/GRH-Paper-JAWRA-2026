@article{bouchardRiskbasedForecastExtreme2019,
  title = {A Risk-Based Forecast of Extreme Mortality Events in Small Cetaceans: {{Using}} Stranding Data to Inform Conservation Practice},
  shorttitle = {A Risk-Based Forecast of Extreme Mortality Events in Small Cetaceans},
  author = {Bouchard, Colin and Bracken, Cameron and Dabin, Willy and Van Canneyt, Olivier and Ridoux, Vincent and Spitz, J{\'e}r{\^o}me and Authier, Matthieu},
  year = 2019,
  journal = {Conservation Letters},
