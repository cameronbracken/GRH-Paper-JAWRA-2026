@article{yapoAutomaticCalibrationConceptual1996,
  title = {Automatic Calibration of Conceptual Rainfall-Runoff Models: Sensitivity to Calibration Data},
  shorttitle = {Automatic Calibration of Conceptual Rainfall-Runoff Models},
  author = {Yapo, Patrice O. and Gupta, Hoshin Vijai and Sorooshian, Soroosh},
  year = 1996,
