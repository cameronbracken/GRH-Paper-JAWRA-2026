@article{liuAdvancingDataAssimilation2012,
  title = {Advancing Data Assimilation in Operational Hydrologic Forecasting: Progresses, Challenges, and Emerging Opportunities},
  shorttitle = {Advancing Data Assimilation in Operational Hydrologic Forecasting},
  author = {Liu, Y. and Weerts, A. H. and Clark, M. and Hendricks Franssen, H.-J. and Kumar, S. and Moradkhani, H. and Seo, D.-J. and Schwanenberg, D. and Smith, P. and {van Dijk}, A. I. J. M. and {van Velzen}, N. and He, M. and Lee, H. and Noh, S. J. and Rakovec, O. and Restrepo, P.},
  year = 2012,
  month = oct,
  journal = {Hydrology and Earth System Sciences},
  volume = {16},
  number = {10},
  pages = {3863--3887},
  publisher = {Copernicus GmbH},
  issn = {1027-5606},
  doi = {10.5194/hess-16-3863-2012},
  urldate = {2025-08-29},
  abstract = {Data assimilation (DA) holds considerable potential for improving hydrologic predictions as demonstrated in numerous research studies. However, advances in hydrologic DA research have not been adequately or timely implemented in operational forecast systems to improve the skill of forecasts for better informed real-world decision making. This is due in part to a lack of mechanisms to properly quantify the uncertainty in observations and forecast models in real-time forecasting situations and to conduct the merging of data and models in a way that is adequately efficient and transparent to operational forecasters.   The need for effective DA of useful hydrologic data into the forecast process has become increasingly recognized in recent years. This motivated a hydrologic DA workshop in Delft, the Netherlands in November 2010, which focused on advancing DA in operational hydrologic forecasting and water resources management. As an outcome of the workshop, this paper reviews, in relevant detail, the current status of DA applications in both hydrologic research and operational practices, and discusses the existing or potential hurdles and challenges in transitioning hydrologic DA research into cost-effective operational forecasting tools, as well as the potential pathways and newly emerging opportunities for overcoming these challenges. Several related aspects are discussed, including (1) theoretical or mathematical aspects in DA algorithms, (2) the estimation of different types of uncertainty, (3) new observations and their objective use in hydrologic DA, (4) the use of DA for real-time control of water resources systems, and (5) the development of community-based, generic DA tools for hydrologic applications. It is recommended that cost-effective transition of hydrologic DA from research to operations should be helped by developing community-based, generic modeling and DA tools or frameworks, and through fostering collaborative efforts among hydrologic modellers, DA developers, and operational forecasters.},
  langid = {english},
  file = {/Users/brac840/Zotero/storage/S4SV4GQ4/Liu et al. - 2012 - Advancing data assimilation in operational hydrologic forecasting progresses, challenges, and emerg.pdf}
}

@article{liUncoveringHistoricalReservoir2024,
  title = {Uncovering {{Historical Reservoir Operation Rules}} and {{Patterns}}: {{Insights From}} 452 {{Large Reservoirs}} in the {{Contiguous United States}}},
  shorttitle = {Uncovering {{Historical Reservoir Operation Rules}} and {{Patterns}}},
  author = {Li, Donghui and Chen, Yanan and Lyu, Lingqi and Cai, Ximing},
  year = 2024,
  journal = {Water Resources Research},
  volume = {60},
  number = {8},
  pages = {e2023WR036686},
  issn = {1944-7973},
  doi = {10.1029/2023WR036686},
  urldate = {2025-12-19},
  abstract = {Reservoir operations are influenced by hydroclimatic variability, reservoir characteristics (i.e., size and purpose), policy regulation, as well as operators' experiences and justification. Data-driven reservoir operation models based on long-term historical records shed light on understanding reservoir operation rules and patterns. This study applies generic data-driven reservoir operation models (GDROMs) developed for 452 data-rich reservoirs with diversified operation purposes across the CONUS to explore typical operation rules and patterns. We find that the operating policies of any of these reservoirs can be modeled with a small number (1--8) of typical operation modules. The derived modules applied to different conditions of the 452 reservoirs can be categorized into five basic types, that is, constant release, inflow-driven piecewise constant release, inflow-driven linear release, storage-driven piecewise constant release, and storage-driven nonlinear (or piecewise linear) release. Additionally, a joint-driven release module, constructed from these five basic types, has been identified. The analysis further shows the module application transition patterns featuring operation dynamics for reservoirs of different operation purposes, sizes, and locations. The typical module types can be used as ``Lego'' bricks to build operation models, especially for data-scarce reservoirs. These module types and their application and transition conditions can inform Standard Operation Policy (SOP) and Hedging Policy (HP) with specific inflow, storage, and/or both conditions.},
  copyright = {\copyright{} 2024. The Author(s).},
