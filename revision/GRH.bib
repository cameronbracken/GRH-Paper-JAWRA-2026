@article{Feng_2022,
  title = {Differentiable, Learnable, Regionalized Process-Based Models with Multiphysical Outputs Can Approach State-of-the-Art Hydrologic Prediction Accuracy},
  author = {Feng, Dapeng and Liu, Jiangtao and Lawson, Kathryn and Shen, Chaopeng},
  year = 2022,
  month = oct,
  journal = {Water Resources Research},
  volume = {58},
  number = {10},
  pages = {e2022WR032404},
  publisher = {American Geophysical Union (AGU)},
  issn = {1944-7973},
  doi = {10.1029/2022wr032404},
  urldate = {2026-01-27},
  abstract = {Predictions of hydrologic variables across the entire water cycle have significant value for water resources management as well as downstream applications such as ecosystem and water quality modeling. Recently, purely data-driven deep learning models like long short-term memory (LSTM) showed seemingly insurmountable performance in modeling rainfall runoff and other geoscientific variables, yet they cannot predict untrained physical variables and remain challenging to interpret. Here, we show that differentiable, learnable, process-based models (called {$\delta$} models here) can approach the performance level of LSTM for the intensively observed variable (streamflow) with regionalized parameterization. We use a simple hydrologic model HBV as the backbone and use embedded neural networks, which can only be trained in a differentiable programming framework, to parameterize, enhance, or replace the process-based model's modules. Without using an ensemble or post-processor, {$\delta$} models can obtain a median Nash-Sutcliffe efficiency of 0.732 for 671 basins across the USA for the Daymet forcing data set, compared to 0.748 from a state-of-the-art LSTM model with the same setup. For another forcing data set, the difference is even smaller: 0.715 versus 0.722. Meanwhile, the resulting learnable process-based models can output a full set of untrained variables, for example, soil and groundwater storage, snowpack, evapotranspiration, and baseflow, and can later be constrained by their observations. Both simulated evapotranspiration and fraction of discharge from baseflow agreed decently with alternative estimates. The general framework can work with models with various process complexity and opens up the path for learning physics from big data.},
  copyright = {\copyright{} 2022. The Authors.},
  langid = {english},
  keywords = {differentiable hydrology,differentiable programming,LSTM,machine learning,physical model,rainfall runoff},
  file = {/Users/brac840/Zotero/storage/ENHZN9NU/Feng et al. - 2022 - Differentiable, Learnable, Regionalized Process-Based Models With Multiphysical Outputs can Approach.pdf;/Users/brac840/Zotero/storage/BIXHIV9L/2022WR032404.html;/Users/brac840/Zotero/storage/J8JFRRZ9/2022WR032404.html}
}

