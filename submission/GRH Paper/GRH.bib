@article{wilczakWindSolarEnergy2025,
  title = {Wind and Solar Energy Droughts: {{Potential}} Impacts on Energy System Dynamics and Research Needs},
  shorttitle = {Wind and Solar Energy Droughts},
  author = {Wilczak, James M. and {Kirk-Davidoff}, Daniel B. and Bloomfield, Hannah and Bracken, Cameron and Sharp, Justin},
  year = 2025,
  month = apr,
  journal = {Journal of Renewable and Sustainable Energy},
  volume = {17},
  number = {2},
  pages = {022301},
  issn = {1941-7012},
  doi = {10.1063/5.0253058},
  urldate = {2025-06-30},
  abstract = {This Perspective article provides a brief overview of the topic of wind and solar energy droughts (henceforth WSDs). It does not attempt to provide a complete literature review of the subject but rather highlights some of the main concepts associated with WSDs. These include wind and solar energy drought definitions and metrics; meteorological conditions producing WSDs; a comparison of their characteristics with hydrologic droughts and hydropower droughts; model-based and observational datasets useful for WSD analyses; the linkage of WSDs to~transmission, storage, and demand response; the potential impacts of WSDs vs energy demand variations; wind and solar flood events; WSD predictability; WSD dependency on climate modes of variability; climate change impacts on WSDs; and the special challenge of evaluating the characteristics of WSDs in developing countries that have limited historical data available. Finally, the manuscript identifies research areas that the authors believe would provide immediate benefit to energy system planners.},
  file = {/Users/brac840/Zotero/storage/ZEG4QI4B/Wilczak et al. - 2025 - Wind and solar energy droughts Potential impacts on energy system dynamics and research needs.pdf;/Users/brac840/Zotero/storage/C7MTG8GQ/Wind-and-solar-energy-droughts-Potential-impacts.html}
