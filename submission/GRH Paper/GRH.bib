@article{Yang2021,
  type = {Journal {{Article}}},
  title = {Global Reach-Level 3-Hourly River Flood Reanalysis (1980-2019)},
  author = {Yang, Y. and Pan, M. and Lin, P. R. and Beck, H. E. and Zeng, Z. Z. and Yamazaki, D. and David, C. H. and Lu, H. and Yang, K. and Hong, Y. and Wood, E. F.},
  year = 2021,
  journal = {Bulletin of the American Meteorological Society},
  volume = {102},
  number = {11},
  pages = {E2086-E2105},
  issn = {0003-0007},
  doi = {10.1175/Bams-D-20-0057.1},
  abstract = {Better understanding and quantification of river floods for very local and "flashy" events calls for modeling capability at fine spatial and temporal scales. However, long-term discharge records with a global coverage suitable for extreme events analysis are still lacking. Here, grounded on recent breakthroughs in global runoff hydrology, river modeling, high-resolution hydrography, and climate reanalysis, we developed a 3-hourly river discharge record globally for 2.94 million river reaches during the 40-yr period of 1980-2019. The underlying modeling chain consists of the VIC land surface model (0.05 degrees, 3-hourly) that is well calibrated and bias corrected and the RAPID routing model (2.94 million river and catchment vectors), with precipitation input from MSWEP and other meteorological fields downscaled from ERA5. Flood events (above 2-yr return) and their characteristics (number, spatial distribution, and seasonality) were extracted and studied. Validations against 3-hourly flow records from 6,000+ gauges in CONUS and daily records from 14,000+ gauges globally show good modeling performance across all flow ranges, good skills in reconstructing flood events (high extremes), and the benefit of (and need for) subdaily modeling.},
  keywords = {rivers flood events hydrology hydrologic models risk assessment land-surface data assimilation vic-2l model large-scale system seasonality parameterization precipitation performance discharge}
}

