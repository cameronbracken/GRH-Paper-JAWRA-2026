@article{sonMonthlyHydropowerGeneration2025,
  title = {Monthly Hydropower Generation Data for {{Western Canada}} to Support {{Western-US}} Interconnect Power System Studies},
  author = {Son, Youngjun and Bracken, Cameron and Broman, Daniel and Voisin, Nathalie},
  year = 2025,
