@article{zhangOptimizationShorttermHydropower2024,
  title = {Optimization of Short-Term Hydropower Scheduling with Dynamic Reservoir Capacity Based on Improved Genetic Algorithm and Parallel Computing},
  author = {Zhang, Rongqi and Zhang, Shanghong and Wen, Xiaoxiong and Yue, Ziqi and Zhou, Yang},
  year = 2024,
  month = jun,
  journal = {Journal of Hydrology},
  volume = {636},
  pages = {131238},
  issn = {0022-1694},
  doi = {10.1016/j.jhydrol.2024.131238},
  urldate = {2025-10-01},
  abstract = {The optimal scheduling of hydropower plants is important for the efficient operation and management of hydropower energy systems. In the short-term optimization scheduling of river-type reservoirs, the dynamic reservoir capacity is a key factor. Currently, the short-term power generation scheduling model considering dynamic reservoir capacity was solved by the enumeration method, providing a more accurate simulation of the water flow process compared to the model considering static reservoir capacity. However, the solving process had the disadvantage of a large computational burden and excessive time consumption, which restricted application in the actual scheduling of reservoirs. Therefore, to solve the time-consuming problem of repeated calculation of hydrodynamics model in optimization scheduling, an improved genetic algorithm including adaptive and elitist-selection strategies combined with the parallel computing technique was proposed. The optimal scheduling plan generated by this model were compared with the optimization results of the enumeration method and the genetic algorithm scheduling model. The results showed that the optimal power generation selected by the three models were extremely similar and the optimization model could find the optimal value for the scheduling period. In terms of computing speed, the improved genetic algorithm parallel technique took approximately 0.8~h, around 246 times faster than the enumeration method and 20 times faster than the model without using parallel computing. It demonstrates that the present algorithm is practically usable, significantly enhancing the optimization efficiency of scheduling solutions. Furthermore, it satisfies the engineering application efficiency requirements and can provide technical support for the subsequent power generation scheduling of the Three Gorges Reservoir.},
  keywords = {Genetic Algorithm,OpenMP,Parallel Computing,Reservoir Optimization Scheduling,Three Gorges Reservoir},
  file = {/Users/brac840/Zotero/storage/T6TYDREX/Zhang et al. - 2024 - Optimization of short-term hydropower scheduling with dynamic reservoir capacity based on improved g.pdf;/Users/brac840/Zotero/storage/W9JRUF5K/S0022169424006334.html}
}

@misc{zhangResolvingCascadeUncertainty2025,
  title = {Resolving the Cascade of Uncertainty in Global Flood Projections},
  author = {Zhang, Boen and Slater, Louise and Moulds, Simon and Wortmann, Michel and Hart, Neil and Liu, Yinxue and Yin, Jiabo and Gu, Xihui and Nearing, Grey and Brunner, Manuela and Roberts, Stephen and Wanders, Niko},
  year = 2025,
  month = jun,
  publisher = {Research Square},
  issn = {2693-5015},
  doi = {10.21203/rs.3.rs-6718520/v1},
  urldate = {2025-06-27},
  abstract = {Projections of river flooding are crucial for adaptation, but conventional impact modelling is plagued by a \&amp;lsquo;cascade of uncertainty\&amp;rsquo; arising from global climate model (GCM) outputs, statistical corrections, and hydrologic model structures. To overcome this cascade, we developed a data-driven approach that uses machine learning (ML) models to directly predict 10-year flood magnitudes from spatially-varying summary statistics derived from 19 uncorrected CMIP6 GCMs. We find that ML models trained on uncorrected GCMs are 40\% more accurate than hydrologic models driven with bias-corrected GCMs. ML rectifies spatially-variable GCM biases by adjusting the contribution of basin attributes, correcting heavy rainfall underestimation in wet river basins. Applying our ML models to over 4.7\&amp;nbsp;million kilometres of global river channels, we find that precipitation intensification is more likely to increase river flood magnitude in dry and high-altitude regions. By 2100, only 34\% of rivers are projected to experience larger floods under SSP5-8.5, with the largest increases found in dry climates and high-altitude, steep river segments.},
  archiveprefix = {Research Square},
  file = {/Users/brac840/Zotero/storage/YMADZDWQ/Zhang et al. - 2025 - Resolving the cascade of uncertainty in global flood projections.pdf}
}

