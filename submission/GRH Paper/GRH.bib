@article{maSpatiallyCoherentClusters2020,
  title = {Spatially Coherent Clusters of Summer Precipitation Extremes in the {{Tibetan Plateau}}: {{Where}} Is the Moisture From?},
  shorttitle = {Spatially Coherent Clusters of Summer Precipitation Extremes in the {{Tibetan Plateau}}},
  author = {Ma, Yingzhao and Lu, Mengqian and Bracken, Cameron and Chen, Haonan},
  year = 2020,
